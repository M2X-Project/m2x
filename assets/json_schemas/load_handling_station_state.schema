{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Load handling station state",
  "description": "All encompassing states of the load handling station (LHS).",
  "subtopic": "/state",
  "type": "object",
  "required": [
    "timestamp",
    "version",
    "serialNumber",
    "connectionStateLHS",
    "loadHandlingPointStates"
  ],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp in ISO8601 Format (YYYY-MM-DDTHH:mm:ss.sssZ). The timestamp defines the point in time at which the message was sent.",
      "examples": [
        "2015-10-21T16:29:00.000Z"
      ]
    },
    "version": {
      "type": "string",
      "description": "Version of the M2X protocol [Major].[Minor].[Patch] (e.g. 1.3.2)",
      "examples": [
        "1.0.0"
      ]
    },
    "serialNumber": {
      "type": "string",
      "description": "Serial number of the LHS."
    },
    "manufacturer": {
      "type": "string",
      "description": "Manufacturer of the LHS."
    },
    "connectionStateLHS": {
      "type": "string",
      "enum": [
        "ONLINE",
        "OFFLINE",
        "CONNECTION_BROKEN"
      ],
      "description": "ONLINE: connection between load handling station and broker is active. OFFLINE: connection between load handling station and broker has gone offline in a coordinated way. CONNECTION_BROKEN: The connection between load handling station and broker has unexpectedly ended."
    },
    "loadHandlingPointStates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "loadHandlingPointId",
          "operationMode",
          "connectionStateLHP",
          "loadHandlingSessionId",
          "requestStates",
          "errors"
        ],
        "properties": {
          "loadHandlingPointId": {
            "type": "string",
            "description": "Unique identifier of the individual LHP of the LHS."
          },
          "operationMode": {
            "type": "string",
            "description": "Current operation mode of the LHS.",
            "enum": [
              "AUTOMATIC",
              "MANUAL",
              "SERVICE"
            ]
          },
          "connectionStateLHP": {
            "type": "string",
            "enum": [
              "ONLINE",
              "OFFLINE",
              "CONNECTION_BROKEN"
            ],
            "description": "ONLINE: connection between load handling point and broker is active. OFFLINE: connection between load handling point and broker has gone offline in a coordinated way. CONNECTION_BROKEN: The connection between load handling point and broker has unexpectedly ended."
          },
          "loadHandlingSessionId": {
            "type": "string",
            "description": "Unique identifier of the complete request session in a process, e.g. the load handling."
          },
          "requestStates": {
            "type": "array",
            "description": "Array of upcoming and current requests.",
            "items": {
              "type": "object",
              "required": [
                "requestId",
                "requestStatus"
              ],
              "properties": {
                "requestId": {
                  "type": "string",
                  "description": "Id of a request to be referred to in this state.",
                  "examples": [
                    "requestAccess_1337"
                  ]
                },
                "requestType": {
                  "type": "string",
                  "description": "requestType of the request.\nOptional: Only for informational or visualization purposes."
                },
                "requestStatus": {
                  "type": "string",
                  "description": "Status of the request.",
                  "enum": [
                    "PENDING",
                    "RUNNING",
                    "PAUSED",
                    "FINISHED",
                    "FAILED"
                  ]
                },
                "resultDescription": {
                  "type": "string",
                  "description": "Description of the result, e.g., the result of a RFID-read. Errors will be transmitted in errors."
                }
              }
            }
          },
          "errors": {
            "type": "array",
            "description": "Array of error-objects. All active errors of the load handling station should be in the list. An empty array indicates that the load handling station has no active errors.",
            "items": {
              "type": "object",
              "required": [
                "errorType",
                "errorLevel"
              ],
              "properties": {
                "errorType": {
                  "type": "string",
                  "description": "Type of error."
                },
                "requestId": {
                  "type": "string",
                  "description": "Id of the request that is caused by or related to the error."
                },
                "errorDescription": {
                  "type": "string",
                  "description": "Verbose description of error."
                },
                "errorLevel": {
                  "type": "string",
                  "description": "Description of the error level, which is warning or fatal. WARNING: load handling station is ready to start (e.g., maintenance cycle expiration warning). FATAL: load handling station is not in running condition, user intervention required.",
                  "enum": [
                    "WARNING",
                    "FATAL"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
